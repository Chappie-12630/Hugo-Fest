# ─────────────────────────────────────────────
#  Hugo Fest — Variables de entorno
#  Copia este archivo como .env.local (desarrollo)
#  En Vercel: Settings → Environment Variables
# ─────────────────────────────────────────────

# ── Firebase ──────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SCANNER_PIN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# ── Resend (emails) ───────────────────────────
# Regístrate en https://resend.com (gratis hasta 3,000 emails/mes)
RESEND_API_KEY=
RESEND_FROM_EMAIL=invitaciones@tudominio.com

# ── Twilio (WhatsApp) ─────────────────────────
# Obtén las credenciales en https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── App ───────────────────────────────────────
# PIN para el escáner de entrada (5296 por defecto)
NEXT_PUBLIC_SCANNER_PIN=5296

# URL del proyecto (Vercel la llena automáticamente en producción)
# Solo necesitas setearla si usas un dominio personalizado
# NEXT_PUBLIC_VERCEL_URL=hugo-fest.vercel.app
